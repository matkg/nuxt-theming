{
  "name": "neu-nuxt",
  "version": "0.2.0",
  "description": "Skin system with neumorphism, glassmorphism and neo-brutalism presets for Nuxt UI (Vue 3) + showcase",
  "scripts": {
    "dev": "npm run dev --workspace playground",
    "build": "npm run build --workspace @neu-nuxt/ui && npm run build --workspace playground",
    "build:lib": "npm run build --workspace @neu-nuxt/ui",
    "preview": "npm run preview --workspace playground",
    "generate:catalog": "node playground/scripts/generate-catalog.mjs"
  },
  "keywords": [
    "nuxt-ui",
    "vue",
    "neumorphism",
    "glassmorphism",
    "neo-brutalism",
    "soft-ui",
    "design-system",
    "component-library"
  ],
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {}
}
