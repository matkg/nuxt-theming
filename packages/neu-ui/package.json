{
  "name": "@neu-nuxt/ui",
  "version": "0.2.0",
  "description": "Skin system + neumorphism, glassmorphism and neo-brutalism presets for Nuxt UI (Vue)",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "nuxt-ui",
    "vue",
    "skin",
    "theme",
    "neumorphism",
    "glassmorphism",
    "neo-brutalism",
    "brutalism",
    "design-system"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./skin": {
      "types": "./dist/skin.d.ts",
      "import": "./dist/skin.js"
    },
    "./skins/neumorphism.css": "./src/skins/neumorphism/neumorphism.css",
    "./skins/glass.css": "./src/skins/glass/glass.css",
    "./skins/neo-brutalism.css": "./src/skins/neo-brutalism/neo-brutalism.css",
    "./theme.css": "./src/skins/neumorphism/neumorphism.css",
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/skins",
    "src/types",
    "src/registry.ts",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/generate-components.mjs && vite build && vue-tsc --emitDeclarationOnly -p tsconfig.build.json",
    "dev": "node scripts/generate-components.mjs && vite build --watch",
    "generate:components": "node scripts/generate-components.mjs"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nuxt/ui": "^4.12.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vue": "^3.5.24",
    "vue-tsc": "^3.1.1"
  }
}
